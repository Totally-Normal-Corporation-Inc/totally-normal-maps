# This file is documentation; the CLI does not automatically load .env files.
MAPS_MODE=production
# Default combined image already sets this and pins its own dataset.
MAPS_BUNDLE=/opt/maps/bundle
# API-only compatibility: omit MAPS_BUNDLE and configure these instead.
# MAPS_DATASET=/data/release
# MAPS_MANIFEST_SHA256=<trusted-release-manifest-sha256>
MAPS_ALLOWED_HOSTS=maps.example.com,localhost,127.0.0.1
# Required in production: inject a JSON object mapping client names to independent
# random 32+ character API keys, sent as Authorization: Bearer <key>.
# Keep actual values in a secrets manager. Generate with Python's secrets module.
MAPS_API_TOKENS=
MAPS_REQUESTS_PER_MINUTE=120
MAPS_CORS_ORIGINS=
# API-only optional bootstrap; task role needs GetObject only.
# MAPS_DATASET_S3_URI=s3://example-maps/releases/version/manifest.json
